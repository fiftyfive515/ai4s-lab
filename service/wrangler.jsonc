{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai4s-lab-insights",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./admin-assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": { "PUBLIC_ORIGIN": "https://fiftyfive515.github.io" },
  "d1_databases": [
    { "binding": "DB", "database_name": "ai4s-lab-visits", "database_id": "REPLACE_AFTER_CREATE" }
  ],
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "EVENT_LIMIT", "namespace_id": "1002", "simple": { "limit": 100, "period": 60 } }
  ],
  "triggers": { "crons": ["0 20 * * *"] },
  "observability": { "enabled": false }
}
